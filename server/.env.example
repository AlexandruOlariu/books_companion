# Copy to .env and fill in. .env is git-ignored; never commit it.
# Generate each value with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET=
# Keyed-hash secret for phone numbers. Losing or changing it makes every stored
# phone number unmatchable, so back it up like the database password.
PHONE_PEPPER=
# Optional: push notifications. Path (inside the container) of a Firebase
# service-account key; see docs/backend.md, "Push notifications". Leave empty to
# keep push off. The key file itself is a secret: never commit it.
FCM_CREDENTIALS_FILE=
