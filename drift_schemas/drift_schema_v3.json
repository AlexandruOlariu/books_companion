  "fixed_sql": [
    {
      "name": "books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"series_name\" TEXT NULL, \"series_number\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "authors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"authors\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "book_authors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book_authors\" (\"book_id\" TEXT NOT NULL REFERENCES books (id) ON DELETE CASCADE, \"author_id\" TEXT NOT NULL REFERENCES authors (id), \"position\" INTEGER NOT NULL, PRIMARY KEY (\"book_id\", \"author_id\"));"
        }
      ]
    },
    {
      "name": "editions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editions\" (\"id\" TEXT NOT NULL, \"book_id\" TEXT NOT NULL REFERENCES books (id) ON DELETE CASCADE, \"page_count\" INTEGER NULL, \"language\" TEXT NULL, \"cover_local_path\" TEXT NULL, \"cover_source\" TEXT NULL, \"metadata_source\" TEXT NOT NULL DEFAULT 'manual', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "user_books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_books\" (\"id\" TEXT NOT NULL, \"book_id\" TEXT NOT NULL REFERENCES books (id) ON DELETE CASCADE, \"edition_id\" TEXT NOT NULL REFERENCES editions (id), \"status\" TEXT NOT NULL, \"current_page\" INTEGER NOT NULL DEFAULT 0, \"added_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reading_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_records\" (\"id\" TEXT NOT NULL, \"user_book_id\" TEXT NOT NULL REFERENCES user_books (id) ON DELETE CASCADE, \"finished_value\" TEXT NULL, \"finished_precision\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reading_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_sessions\" (\"id\" TEXT NOT NULL, \"user_book_id\" TEXT NOT NULL REFERENCES user_books (id) ON DELETE CASCADE, \"started_at\" INTEGER NOT NULL, \"start_page\" INTEGER NULL, \"end_page\" INTEGER NULL, \"duration_seconds\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pins\" (\"id\" TEXT NOT NULL, \"user_book_id\" TEXT NOT NULL REFERENCES user_books (id) ON DELETE CASCADE, \"text_content\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"page\" INTEGER NULL, \"progress_percent\" REAL NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
}